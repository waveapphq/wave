# WAVE E2E real-service SSH server - base config (test-only).
# Used by the main `sshd` and the `nested-sshd` jump-host services.
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
PasswordAuthentication yes
PubkeyAuthentication yes
AllowTcpForwarding yes
PermitRootLogin no
X11Forwarding no
PrintMotd no
Subsystem sftp /usr/lib/openssh/sftp-server

# SFTP-only account: chrooted, SFTP only, no forwarding.
Match User dropzone
    ChrootDirectory /srv/sftp/dropzone
    ForceCommand internal-sftp
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    PermitTunnel no
    PermitTTY no
    X11Forwarding no

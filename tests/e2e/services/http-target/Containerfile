# Internal-only E2E HTTP(S) target: the unmodified HTTPS simulator.
# Build: scripts/e2e/e2e-stack.sh build (context tests/e2e)
FROM node:22-slim

RUN npm install -g tsx@4 >/dev/null 2>&1

WORKDIR /app
# Context is tests/e2e so the simulator and its certs are copied unmodified.
COPY simulators/https /app/https

ENV HTTPS_SIMULATOR_PORT=9443
ENV HTTPS_HEALTH_PORT=9444
EXPOSE 9443 9444

CMD ["tsx", "/app/https/server.ts"]

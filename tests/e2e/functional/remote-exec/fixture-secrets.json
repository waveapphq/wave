{
  "name": "Remote Execution Secrets Canary E2E",
  "version": "1.0.0",
  "description": "Remote-path secret canary: a marked-secret remote OUTPUT (http body), a remote HTTP response Set-Cookie header, and a profile credential used over the remote path all mask on the remote block's DEBUG echo / WS / report / disk.",
  "workflow": {
    "nodes": [
      {
        "id": "delay-hold",
        "type": "workflowNode",
        "position": { "x": -75, "y": 40 },
        "data": {
          "label": "Delay",
          "elementType": "delay",
          "nodeType": "control",
          "category": "timing",
          "version": "1.0.0",
          "description": "WS Subscribe Window",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": { "values": { "duration": 2000 }, "outputBindings": {}, "profileBindings": [] }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "open-session",
        "type": "workflowNode",
        "position": { "x": -75, "y": 110 },
        "data": {
          "label": "SSH Session Open",
          "elementType": "ssh-session-open",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Open session (execution host)",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "host": "127.0.0.1",
              "port": 9445,
              "username": "wave",
              "password": "wave-secret",
              "host_key_verification": "disabled"
            },
            "outputBindings": { "session_id": "sid", "connected": "s_conn" },
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "container",
        "type": "workflowNode",
        "position": { "x": -75, "y": 180 },
        "data": {
          "label": "Remote Execution",
          "elementType": "remote-execution",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Run body on the host",
          "hasNewerVersion": false,
          "expressionFields": ["session_id"],
          "templateFields": [],
          "config": {
            "values": { "session_id": "sid" },
            "outputBindings": { "remote_session_id": "rsid" },
            "profileBindings": []
          }
        },
        "measured": { "width": 160, "height": 62 }
      },
      {
        "id": "http-in",
        "type": "workflowNode",
        "position": { "x": 160, "y": 260 },
        "data": {
          "label": "HTTP",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Remotable HTTP (runs on host), profile cred in the URL, body marked secret",
          "hasNewerVersion": false,
          "expressionFields": ["url"],
          "templateFields": [],
          "config": {
            "values": {
              "url": "f'https://http-target:9443/secret-payload?tok={rex.auth_key}'",
              "method": "GET",
              "timeout": 30,
              "retry_count": 0,
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": { "status_code": "rx_status", "body": "rx_body" },
            "outputSecretFields": ["body"],
            "profileBindings": [
              {
                "profileId": "__PROFILE_ID__",
                "alias": "rex",
                "profileName": "__PROFILE_NAME__",
                "profileType": "http"
              }
            ]
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "http-cookie",
        "type": "workflowNode",
        "position": { "x": 160, "y": 295 },
        "data": {
          "label": "HTTP",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Remotable HTTP (runs on host), response carries a Set-Cookie credential",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "url": "https://http-target:9443/cookie",
              "method": "GET",
              "timeout": 30,
              "retry_count": 0,
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": { "status_code": "ck_status", "headers": "rx_headers" },
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "log-in",
        "type": "workflowNode",
        "position": { "x": 160, "y": 330 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Log body result + response headers + profile cred",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f'in-body rx={rx_status} ck={ck_status} bodycheck={rx_body} cookiecheck={rx_headers} tok={rex.auth_key} remote-body-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": [
              {
                "profileId": "__PROFILE_ID__",
                "alias": "rex",
                "profileName": "__PROFILE_NAME__",
                "profileType": "http"
              }
            ]
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "log-then",
        "type": "workflowNode",
        "position": { "x": -75, "y": 410 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Then + remote session id + bookend",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f'then rsid_len={len(rsid)} remote-secrets-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      }
    ],
    "edges": [
      { "id": "e-start", "source": "start-node", "target": "delay-hold" },
      { "id": "e-delay-open", "source": "delay-hold", "target": "open-session" },
      { "id": "e-open-container", "source": "open-session", "target": "container" },
      { "id": "e-body", "source": "container", "sourceHandle": "body", "target": "http-in", "type": "default" },
      { "id": "e-http-cookie", "source": "http-in", "target": "http-cookie" },
      { "id": "e-cookie-log", "source": "http-cookie", "target": "log-in" },
      { "id": "e-then", "source": "container", "sourceHandle": "then", "target": "log-then", "type": "default" }
    ]
  },
  "variables": {
    "sid": { "value": "", "type": "string", "scope": "test" },
    "s_conn": { "value": false, "type": "boolean", "scope": "test" },
    "rsid": { "value": "", "type": "string", "scope": "test" },
    "rx_status": { "value": 0, "type": "integer", "scope": "test" },
    "ck_status": { "value": 0, "type": "integer", "scope": "test" },
    "rx_body": { "value": "", "type": "string", "scope": "test" },
    "rx_headers": { "value": {}, "type": "map", "scope": "test" }
  },
  "metadata": { "tags": [], "suite_id": null, "parent_suite": null }
}

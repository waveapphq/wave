        "data": {
          "label": "SSH Session Exec",
          "elementType": "ssh-session-exec",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Check the remote SQLite file, then remove this run's folder",
          "hasNewerVersion": false,
          "expressionFields": [
            "session_id"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid",
              "command": "f=\"$HOME/sqlrem-__TOKEN__\"; if [ -s \"$f/remote.db\" ]; then printf 'present '; else printf 'absent '; fi; rm -rf \"$f\"; if [ -e \"$f\" ]; then echo left; else echo removed; fi",

      {
        "id": "34093a51-f828-4b63-9dff-e103475ae404",
        "type": "workflowNode",
        "position": {
          "x": 120,
          "y": 1160
        },
        "data": {
          "label": "Python",
          "elementType": "python",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Report the worker's scratch dir and the wheels unpacked so far",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "script_type": "source",
              "script": "import os\n\nworker_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nwheels_dir = os.path.join(worker_dir, \"wheels\")\ncarried = sorted(name for name in os.listdir(wheels_dir) if name.endswith(\".dist-info\"))\n",
              "interpreter": "python3",
              "script_variables": [
                "worker_dir",
                "carried"
              ]
            },
            "outputBindings": {
              "worker_dir": "probe_a_dir",
              "carried": "probe_a_wheels"

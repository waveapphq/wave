        "data": {
          "label": "SQLite remote",
          "elementType": "sql-client",
          "nodeType": "plugin",
          "category": "database",
          "version": "1.0.0",
          "description": "SQLite in this run's folder on the remote host, build carried as a wheel",
          "hasNewerVersion": false,
          "expressionFields": [
            "file"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "operation": "run_sql",
              "database_type": "sqlite",
              "file": "lite_dir.strip() + '/remote.db'",
              "script_type": "source",
              "sql": "CREATE TABLE marks (label TEXT);\nINSERT INTO marks (label) VALUES (:tag);\nSELECT sqlite_version() AS lib, label FROM marks;",
              "parameters": {
                "tag": "sqlrem-__TOKEN__"
              },
              "stop_on_error": true,
              "on_error": "fail"
            },
            "outputBindings": {
              "success": "lr_ok",
              "rows": "lr_rows",
              "rows_changed": "lr_changed"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "85377022-edb0-4806-b1e6-beb8dcc2d50b",
        "type": "workflowNode",
        "position": {
          "x": 120,
          "y": 1300
        },
        "data": {
          "label": "Python",
          "elementType": "python",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Report the worker's scratch dir, the wheels unpacked for SQLite and its build tags",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "script_type": "source",
              "script": "import os\n\nworker_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nwheels_dir = os.path.join(worker_dir, \"wheels\")\ncarried = sorted(name for name in os.listdir(wheels_dir) if name.endswith(\".dist-info\"))\nsqlite_tags = []\nfor name in carried:\n    if name.startswith(\"apsw-\"):\n        with open(os.path.join(wheels_dir, name, \"WHEEL\"), encoding=\"utf-8\") as handle:\n            sqlite_tags = [\n                line.split(\":\", 1)[1].strip() for line in handle if line.startswith(\"Tag:\")\n            ]\n",
              "interpreter": "python3",
              "script_variables": [
                "worker_dir",
                "carried",
                "sqlite_tags"
              ]
            },
            "outputBindings": {
              "worker_dir": "probe_l_dir",
              "carried": "probe_l_wheels",
              "sqlite_tags": "probe_l_tags"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },

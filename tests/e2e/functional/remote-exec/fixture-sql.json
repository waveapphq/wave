          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid",
              "command": "python3 -c \"import importlib.util as u; print(','.join(n for n in ('pg8000', 'pymysql', 'pytds', 'oracledb', 'OpenSSL', 'cryptography', 'apsw') if u.find_spec(n)) or 'none')\"",
              "timeout": 30
            },
            "outputBindings": {

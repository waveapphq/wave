{
  "name": "Remote Execution TLS No-CA Negative E2E",
  "version": "1.0.0",
  "description": "",
  "workflow": {
    "nodes": [
      {
        "id": "open-session",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 40
        },
        "data": {
          "label": "SSH Session Open",
          "elementType": "ssh-session-open",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Open session (execution host)",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "host": "127.0.0.1",
              "port": 9445,
              "username": "wave",
              "password": "wave-secret",
              "host_key_verification": "disabled"
            },
            "outputBindings": {
              "session_id": "sid",
              "connected": "s_conn"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "container",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 110
        },
        "data": {
          "label": "Remote Execution",
          "elementType": "remote-execution",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Run body on the host",
          "hasNewerVersion": false,
          "expressionFields": [
            "session_id"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid"
            },
            "outputBindings": {
              "remote_session_id": "rsid"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 160,
          "height": 62
        }
      },
      {
        "id": "r-noca",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 190
        },
        "data": {
          "label": "HTTP",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Remote verify-on without CA (PERM-10 negative)",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "url": "https://http-target:9443/echo",
              "method": "GET",
              "timeout": 30,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": [
                "502",
                "503",
                "504"
              ],
              "verify_ssl": true,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": {
              "status_code": "nc_status"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-then",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 280
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Then bookend",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f'then rsid_len={len(rsid)} remote-noca-then-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "e-start",
        "source": "start-node",
        "target": "open-session",
        "type": "default"
      },
      {
        "id": "e-open-container",
        "source": "open-session",
        "target": "container",
        "type": "default"
      },
      {
        "id": "e-body",
        "source": "container",
        "target": "r-noca",
        "type": "default",
        "sourceHandle": "body"
      },
      {
        "id": "e-then",
        "source": "container",
        "target": "log-then",
        "type": "default",
        "sourceHandle": "then"
      }
    ]
  },
  "variables": {
    "sid": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "s_conn": {
      "value": false,
      "type": "boolean",
      "scope": "test"
    },
    "rsid": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "nc_status": {
      "value": 0,
      "type": "integer",
      "scope": "test"
    }
  },
  "metadata": {
    "tags": [],
    "suite_id": null,
    "parent_suite": null
  }
}

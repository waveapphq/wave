{
  "name": "SH-17 probe __TOKEN__",
  "version": "1.0.0",
  "description": "Counts the Remote Execution worker processes on the shared SSH host, or, once the spec writes a pid list into the probe command, reports gone or alive for each pid.",
  "workflow": {
    "nodes": [
      {
        "id": "open-session",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 100
        },
        "data": {
          "label": "SSH Session Open",
          "elementType": "ssh-session-open",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Open the host session",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "host": "127.0.0.1",
              "port": 9445,
              "username": "wave",
              "password": "wave-secret",
              "host_key_verification": "disabled",
              "connect_timeout": 30
            },
            "outputBindings": {
              "session_id": "sid"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "probe-exec",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 200
        },
        "data": {
          "label": "SSH Session Exec",
          "elementType": "ssh-session-exec",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "Host worker probe",
          "hasNewerVersion": false,
          "expressionFields": [
            "session_id"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid",
              "command": "c=0; for d in /proc/[0-9]*; do tr '\\0' ' ' < \"$d/cmdline\" 2>/dev/null | grep -q \"wave[-]worker\" && c=$((c+1)); done; printf '%s' \"$c\"",
              "timeout": 30
            },
            "outputBindings": {
              "stdout": "host_probe"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-done",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 300
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'SH-17-probe-done-__TOKEN__'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "e-start-open",
        "source": "start-node",
        "target": "open-session"
      },
      {
        "id": "e-open-probe",
        "source": "open-session",
        "target": "probe-exec"
      },
      {
        "id": "e-probe-done",
        "source": "probe-exec",
        "target": "log-done"
      }
    ]
  },
  "variables": {
    "sid": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "host_probe": {
      "value": "seed",
      "type": "string",
      "scope": "test"
    }
  },
  "metadata": {
    "tags": [],
    "suite_id": null,
    "parent_suite": null
  }
}

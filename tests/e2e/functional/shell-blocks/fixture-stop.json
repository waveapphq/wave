{
  "name": "SH-8 __TOKEN__",
  "version": "1.0.0",
  "description": "A Shell Script with Log Output leaves a background sleep, prints its ready line and sleeps until the user stops the run; Run Current on the probe proves the background job is gone.",
  "workflow": {
    "nodes": [
      {
        "id": "sh-stop",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 100
        },
        "data": {
          "label": "Shell Script",
          "elementType": "shell-script",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Stop ends the tree",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "script_type": "source",
              "script": "mkdir -p \"$WAVE_ARTIFACTS_DIR/sh-8-__TOKEN__\"; sleep 300 & echo $! > \"$WAVE_ARTIFACTS_DIR/sh-8-__TOKEN__/bg.pid\"; P=rea; echo \"${P}dy-__TOKEN__\"; sleep 300",
              "stream_output": true
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "sh-stop-probe",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 190
        },
        "data": {
          "label": "Shell Exec",
          "elementType": "shell-exec",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Stop tree probe",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "command": "f=\"$WAVE_ARTIFACTS_DIR/sh-8-__TOKEN__/bg.pid\"; [ -s \"$f\" ] || { printf missing; exit 0; }; pid=$(cat \"$f\"); if kill -0 \"$pid\" 2>/dev/null && [ \"$(awk '{print $3}' /proc/$pid/stat)\" != Z ]; then printf alive; else printf gone; fi"
            },
            "outputBindings": {
              "stdout": "stop_probe"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }

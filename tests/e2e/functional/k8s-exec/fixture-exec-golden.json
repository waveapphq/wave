{
  "name": "K8s Exec Golden",
  "version": "1.0.0",
  "description": "",
  "workflow": {
    "nodes": [
      {
        "id": "connect-admin",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 100
        },
        "data": {
          "label": "K8s Connect",
          "elementType": "k8s-connect",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Session for sess_admin",
          "hasNewerVersion": false,
          "expressionFields": [
            "token",
            "ca_cert"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "api_url": "https://127.0.0.1:9460",
              "namespace": "",
              "timeout": 30,
              "verify_ssl": true,
              "ca_cert": "k8s_ca",
              "token": "k8s_admin_token"
            },
            "outputBindings": {
              "session": "sess_admin"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "exec-golden",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 170
        },
        "data": {
          "label": "K8s Exec",
          "elementType": "k8s-exec",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "golden: a busybox command that exits 0",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "sess_admin",
              "pod": "wave-pod-exec",
              "container": "app",
              "command": "sh -c \"echo golden-ok\""
            },
            "outputBindings": {
              "stdout": "golden_stdout",
              "stderr": "golden_stderr",
              "exit_code": "golden_exit",
              "success": "golden_ok"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-golden",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 240
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Marker for golden",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f'[KE-01|KE-02] golden exit={golden_exit} ok={golden_ok}'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-done",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 310
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'k8s-exec-golden-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "edge-start-connect-admin",
        "source": "start-node",
        "target": "connect-admin"
      },
      {
        "id": "edge-connect-admin-exec-golden",
        "source": "connect-admin",
        "target": "exec-golden"
      },
      {
        "id": "edge-exec-golden-log-golden",
        "source": "exec-golden",
        "target": "log-golden"
      },
      {
        "id": "edge-log-golden-log-done",
        "source": "log-golden",
        "target": "log-done"
      }
    ]
  },
  "variables": {
    "k8s_ca": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "sess_admin": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "k8s_admin_token": {
      "value": "",
      "type": "string",
      "scope": "test",
      "secret": true
    },
    "golden_stdout": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "golden_stderr": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "golden_exit": {
      "value": 0,
      "type": "integer",
      "scope": "test"
    },
    "golden_ok": {
      "value": false,
      "type": "boolean",
      "scope": "test"
    }
  },
  "metadata": {
    "tags": [],
    "suite_id": null,
    "parent_suite": null
  }
}

        "data": {
          "label": "K8s Connect",
          "elementType": "k8s-connect",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "The cluster by its stack name",
          "hasNewerVersion": false,
          "expressionFields": [
            "token",
            "ca_cert"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "api_url": "https://kwok:6443",
              "namespace": "wave-e2e-golden-write",
              "timeout": 30,
              "token": "k8s_admin_token",
              "verify_ssl": true,
              "ca_cert": "k8s_ca"
            },
            "outputBindings": {
              "session": "sess_a",
              "cluster_version": "ver_a"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "apply-cm",
        "type": "workflowNode",
        "position": {
          "x": 120,
          "y": 310
        },
        "data": {
          "label": "K8s Apply",
          "elementType": "k8s-apply",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Apply a ConfigMap from the form",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "sess_a",
              "timeout": 30,
              "namespace": "wave-e2e-golden-write",
              "define_with": "form",
              "kind": "ConfigMap",
              "name": "wave-remote-cm",
              "data": {
                "locus": "remote"
              },
              "if_exists": "update",
              "output_format": "map",
              "on_error": "fail"
            },
            "outputBindings": {
              "summary": "cm_summary",
              "result": "cm_result",
              "names": "cm_names",
              "count": "cm_count",
              "success": "cm_ok"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "get-cm",
        "type": "workflowNode",
        "position": {
          "x": 120,
          "y": 380
        },
        "data": {
          "label": "K8s Get",
          "elementType": "k8s-get",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Read the applied ConfigMap back",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "sess_a",
              "timeout": 30,
              "resource_type": "default",
              "kind": "ConfigMap",
              "search_by": "name",
              "name": "wave-remote-cm",
              "output_format": "map",
              "namespace": "wave-e2e-golden-write",
              "on_error": "fail"
            },
            "outputBindings": {
              "result": "read_result",
              "count": "read_count"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },

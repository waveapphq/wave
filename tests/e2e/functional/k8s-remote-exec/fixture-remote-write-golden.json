          "label": "K8s Apply",
          "elementType": "k8s-apply",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Apply a manifest whose date is text",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "sess_a",
              "timeout": 30,
              "namespace": "wave-e2e-golden-write",
              "define_with": "manifest",
              "manifest": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: wave-remote-dated\ndata:\n  expires: 2026-01-01\n---\n",
              "if_exists": "update",
              "output_format": "map",
              "on_error": "fail"
            },
            "outputBindings": {
              "summary": "dt_summary",
              "result": "dt_result",
              "names": "dt_names",
              "count": "dt_count",
              "success": "dt_ok"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },

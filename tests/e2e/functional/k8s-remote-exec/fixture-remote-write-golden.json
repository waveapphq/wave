          "category": "remote",
          "version": "1.0.0",
          "description": "SSH session the worker rides",
          "hasNewerVersion": false,
          "expressionFields": [
            "password"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "host": "127.0.0.1",
              "port": 9445,
              "username": "wave",
              "password": "ssh_pwd",
              "host_key_verification": "disabled"
            },
            "outputBindings": {
              "session_id": "sid"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {

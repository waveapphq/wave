{
  "name": "V-NET-CERT-CONSUMERS",
  "version": "1.0.0",
  "description": "A blank CA with verification on in every non-HTTP block that dials TLS: PostgreSQL, SQL Server, OpenSearch, K8s Connect and a Helm Install from the HTTPS chart repository, each recording or catching its failure so one run shows them all; a PostgreSQL block with TLS off reads its own session from pg_stat_ssl.",
  "workflow": {
    "nodes": [
      {
        "id": "pg-tls",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 60
        },
        "data": {
          "label": "PG trust",
          "elementType": "sql-client",
          "nodeType": "plugin",
          "category": "database",
          "version": "1.0.0",
          "description": "PG trust",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "operation": "run_sql",
              "database_type": "postgresql",
              "host": "127.0.0.1",
              "database": "wave",
              "username": "wave",
              "password": "",
              "port": 9473,
              "tls": true,
              "verify_ssl": true,
              "ca_cert": "",
              "script_type": "source",
              "sql": "SELECT s.ssl, s.version FROM pg_stat_ssl AS s WHERE s.pid = pg_backend_pid()",
              "timeout": 60,
              "on_error": "record"
            },
            "outputBindings": {
              "success": "pg_ok",
              "error": "pg_err",
              "reason": "pg_reason",
              "rows": "pg_rows"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },

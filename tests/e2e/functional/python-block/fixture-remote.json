      {
        "id": "ssh-cleanup",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 620
        },
        "data": {
          "label": "SSH Session Exec",
          "elementType": "ssh-session-exec",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "",
          "hasNewerVersion": false,
          "expressionFields": [
            "session_id",
            "command"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid",
              "command": "f\"rm -rf {run_dir}; test -e {run_dir} && echo present || echo gone\"",
              "timeout": 30
            },
            "outputBindings": {
              "stdout": "gone_probe"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }

      {
        "id": "py-logs",
        "type": "workflowNode",
        "position": {
          "x": 700,
          "y": 1000
        },
        "data": {
          "label": "Python",
          "elementType": "python",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "script_type": "source",
              "script": "import logging\nimport os\nimport sys\nimport tempfile\nimport time\n\nstart_dir = os.getcwd()\nsystem_temp = tempfile.gettempdir()\n\nTAG = [\"pyrem\", \"log\"]\n\n\ndef mark(kind):\n    return \"-\".join(TAG + [kind])\n\n\nprint(mark(\"stdout\"))\nsys.stderr.write(mark(\"stderr\") + \"\\n\")\nlogging.debug(mark(\"debug\"))\nlogging.info(mark(\"info\"))\nlogging.warning(mark(\"warning\"))\nlogging.error(mark(\"error\"))\nlogging.critical(mark(\"critical\"))\nsys.stdout.flush()\nsys.stderr.flush()\ntime.sleep(6)\nworker_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n",
              "interpreter": "python3",
              "stream_output": true,
              "script_variables": [
                "worker_dir",
                "start_dir",
                "system_temp"
              ]
            },
            "outputBindings": {
              "worker_dir": "py_worker_dir",
              "start_dir": "py_start_dir",
              "system_temp": "py_system_temp"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }

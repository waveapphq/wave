      {
        "id": "ssh-worker-gone",
        "type": "workflowNode",
        "position": {
          "x": 400,
          "y": 700
        },
        "data": {
          "label": "SSH Session Exec",
          "elementType": "ssh-session-exec",
          "nodeType": "plugin",
          "category": "remote",
          "version": "1.0.0",
          "description": "",
          "hasNewerVersion": false,
          "expressionFields": [
            "session_id",
            "command"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session_id": "sid",
              "command": "'d=' + py_worker_dir + '; n=0; while [ -e \"$d\" ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n+1)); done; if [ -e \"$d\" ]; then echo left; else echo gone; fi'",
              "timeout": 30
            },
            "outputBindings": {
              "stdout": "worker_probe"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }

        "data": {
          "label": "Python",
          "elementType": "python",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "script_type": "source",
              "script": "import logging\nimport sys\n\nP = \"pysecret\"\nSEP = \"-\"\nID = \"a41c9d\"\n\nout_canary = SEP.join([P, \"out\", ID])\nerr_canary = SEP.join([P, \"err\", ID])\nplain = SEP.join([\"pyrem\", \"secret\", \"visible\"])\n\nprint(out_canary)\nsys.stderr.write(err_canary + \"\\n\")\nlogging.info(plain)\nsys.stdout.flush()\nsys.stderr.flush()\nsys.exit(3)\n",
              "interpreter": "python3",
              "stream_output": true,
              "on_error": "record"
            },
            "outputBindings": {
              "stdout": "sec_out",
              "stderr": "sec_err",
              "error": "sec_error",
              "reason": "sec_reason",
              "exit_code": "sec_code"
            },
            "profileBindings": [],
            "outputSecretFields": [
              "stdout",
              "stderr"
            ]
          }
        },

        "data": {
          "label": "SQL",
          "elementType": "sql-client",
          "nodeType": "plugin",
          "category": "database",
          "version": "1.0.0",
          "description": "PostgreSQL through its tunnel, TLS verified against the far host",
          "hasNewerVersion": false,
          "expressionFields": [
            "port",
            "ca_cert"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "operation": "run_sql",
              "database_type": "postgresql",
              "host": "localhost",
              "port": "lport_pg",
              "database": "wave",
              "username": "wave",
              "password": "",
              "script_type": "source",
              "sql": "CREATE TABLE sqltun___TOKEN__ (id integer PRIMARY KEY, label varchar(40));\nINSERT INTO sqltun___TOKEN__ (id, label) VALUES (1, :tag), (2, 'far-end');\nSELECT host(inet_client_addr()) AS client_addr, current_database() AS db,\n  (SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()) AS tls,\n  (SELECT count(*) FROM sqltun___TOKEN__) AS stored;",
              "parameters": {
                "tag": "through-the-tunnel"
              },
              "stop_on_error": true,
              "tls": true,
              "on_error": "fail",
              "verify_ssl": true,
              "ca_cert": "ca_pem"
            },
            "outputBindings": {
              "success": "pg_ok",
              "rows": "pg_rows",
              "row_count": "pg_count",
              "rows_changed": "pg_changed"
            },
            "profileBindings": []
          }
        },

        "data": {
          "label": "PG Null Parameters",
          "elementType": "sql-client",
          "nodeType": "plugin",
          "category": "data",
          "version": "1.0.0",
          "description": "A literal null and a None parameter bind NULL, empty text binds empty text",
          "hasNewerVersion": false,
          "expressionFields": ["parameters.expr_null"],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": {
              "database_type": "postgresql",
              "host": "127.0.0.1",
              "operation": "run_sql",
              "script_type": "source",
              "sql": "SELECT CAST(:lit_null AS VARCHAR(10)) IS NULL AS lit_is_null, CAST(:expr_null AS VARCHAR(10)) IS NULL AS expr_is_null, CAST(:empty_text AS VARCHAR(10)) IS NULL AS empty_is_null, CAST(:empty_text AS VARCHAR(10)) AS empty_value;",
              "parameters": {
                "lit_null": null,
                "expr_null": "None",
                "empty_text": ""
              },
              "on_error": "fail"
            },
            "outputBindings": {
              "rows": "pg_rows"
            },
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },

          "config": {
            "values": {
              "database_type": "postgresql",
              "host": "127.0.0.1",
              "operation": "run_sql",
              "script_type": "source",
              "sql": "CREATE TABLE nv_pg___TOKEN__ (id INTEGER PRIMARY KEY, note VARCHAR(40));\nINSERT INTO nv_pg___TOKEN__ (id, note) VALUES (1, :empty_note);\nINSERT INTO nv_pg___TOKEN__ (id, note) VALUES (2, :null_note);\nCREATE PROCEDURE nv_pg_kind___TOKEN__(v VARCHAR, OUT kind VARCHAR)\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  kind := CASE WHEN v IS NULL THEN 'is-null' WHEN v = '' THEN 'is-empty' ELSE 'is-text' END;\nEND\n$$;\nSELECT id, note, note IS NULL AS note_is_null FROM nv_pg___TOKEN__ ORDER BY id;",
              "parameters": {
                "empty_note": "",
                "null_note": "None"
              },
              "on_error": "fail"
            },
            "outputBindings": {
              "success": "pg_ok",
              "rows": "pg_rows",
              "rows_changed": "pg_changed"

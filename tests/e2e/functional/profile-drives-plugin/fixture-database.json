{
  "name": "Profile Drives Database E2E Test",
  "version": "1.0.0",
  "description": "",
  "workflow": {
    "nodes": [
      {
        "id": "6aea51e3-9ddd-47cd-9d81-0a59173b6217",
        "type": "workflowNode",
        "position": { "x": -75, "y": 100 },
        "data": {
          "label": "SQL",
          "elementType": "sql-client",
          "nodeType": "plugin",
          "category": "database",
          "version": "1.0.0",
          "description": "Every connection and trust row comes from the profile",
          "hasNewerVersion": false,
          "expressionFields": [
            "host",
            "port",
            "database",
            "username",
            "password",
            "verify_ssl",
            "ca_cert",
            "client_cert",
            "client_key",
            "driver_options"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "operation": "run_sql",
              "database_type": "postgresql",
              "host": "dbp.host",
              "port": "dbp.port",
              "database": "dbp.database",
              "username": "dbp.username",
              "password": "dbp.password",
              "script_type": "source",
              "sql": "SELECT current_user AS who, current_database() AS db, s.ssl AS tls, s.client_dn AS client_dn, current_setting('application_name') AS app FROM pg_stat_ssl s WHERE s.pid = pg_backend_pid()",
              "parameters": {},
              "stop_on_error": true,
              "timeout": 300,
              "tls": true,
              "verify_ssl": "dbp.verify_ssl",
              "ca_cert": "dbp.ca_cert",
              "client_cert": "dbp.client_cert",
              "client_key": "dbp.client_key",
              "connect_timeout": 30,
              "max_rows": 10000,
              "driver_options": "dbp.driver_options",
              "on_error": "fail"
            },
            "outputBindings": { "success": "id_ok", "rows": "id_rows", "row_count": "id_count" },
            "profileBindings": [
              {
                "profileId": "__DB_PROFILE_ID__",
                "alias": "dbp",
                "profileName": "__DB_PROFILE_NAME__",
                "profileType": "database"
              }
            ]
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "eca1cbc6-b55d-4825-8cd7-4db56e447b57",
        "type": "workflowNode",
        "position": { "x": -75, "y": 170 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Log what the database saw of the profile-driven session",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f\"dbprof ok={id_ok} count={id_count} who={id_rows[0]['who']} db={id_rows[0]['db']} tls={id_rows[0]['tls']} dn=[{id_rows[0]['client_dn']}] app={id_rows[0]['app']}\"",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {

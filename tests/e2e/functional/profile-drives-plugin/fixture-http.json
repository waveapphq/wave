          "version": "1.0.0",
          "description": "Log the mTLS leg",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": { "message": "f'httpprof-tls status={tls_status} body={tls_body}'", "level": "INFO" },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "log-done",
        "type": "workflowNode",
        "position": { "x": -75, "y": 520 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend marker",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": { "message": "'profile-http-e2e-done'", "level": "INFO" },

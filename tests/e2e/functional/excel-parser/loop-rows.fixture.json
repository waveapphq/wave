        "sourceHandle": "then",
        "target": "read-accumulated",
        "type": "default"
      },
      { "id": "e9", "source": "read-accumulated", "target": "log-accumulated", "type": "default" },
      { "id": "e10", "source": "log-accumulated", "target": "log-stored", "type": "default" }
    ]

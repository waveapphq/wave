        "position": { "x": 640, "y": 620 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Log Accumulated",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'xl-acc-sheets=' + ','.join(acc_sheets)",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "log-stored",
        "type": "workflowNode",
        "position": { "x": 640, "y": 720 },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Log Stored",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'xl-loop-stored=' + str(len(stored_rows)) + '-last-' + str(seen_sku) + '-cell-' + str(stored_rows.col('qty')[2])",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      }
    ],
    "edges": [
      { "id": "e1", "source": "start-node", "target": "parse-src", "type": "default" },
      { "id": "e2", "source": "parse-src", "target": "write-rows", "type": "default" },
      { "id": "e3", "source": "write-rows", "target": "read-rows", "type": "default" },
      { "id": "e4", "source": "read-rows", "target": "foreach-rows", "type": "default" },
      {
        "id": "e5",

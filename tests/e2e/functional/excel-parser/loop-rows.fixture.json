        "sourceHandle": "body",
        "target": "body-log-row",
        "type": "default"
      },
      { "id": "e6", "source": "body-log-row", "target": "body-store-row", "type": "default" },
      { "id": "e7", "source": "body-store-row", "target": "body-write-sheet", "type": "default" },
      {
        "id": "e8",

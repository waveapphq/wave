            "values": {
              "message": "'xl-people-schema=' + people_schema[0]['name'] + ':' + people_schema[0]['type'] + ',' + people_schema[1]['name'] + ':' + people_schema[1]['type'] + ',' + people_schema[2]['name'] + ':' + people_schema[2]['type'] + ',' + people_schema[3]['name'] + ':' + people_schema[3]['type'] + ',' + people_schema[4]['name'] + ':' + people_schema[4]['type']",

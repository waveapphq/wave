{
  "name": "Excel Parser - Read a workbook authored outside WAVE",
  "version": "1.0.0",
  "description": "Two workbooks produced by LibreOffice Calc are uploaded as this test's own test data, then read: typed columns, ISO dates, a sheet chosen by position with a range and an offset header row, an uncomputed formula reported in errors, and the macro-enabled format.",
  "workflow": {
    "nodes": [
      {
        "id": "read-people",
        "type": "workflowNode",
        "position": { "x": 400, "y": 300 },
        "data": {

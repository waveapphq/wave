          "elementType": "excel-parser",
          "nodeType": "plugin",
          "category": "data",
          "version": "1.0.0",
          "description": "Read People",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "operation": "read",
              "workbook": "testdata://sample_workbook.xlsx",
              "has_header": true,
              "header_row": 1,
              "column_types": "auto"
            },
            "outputBindings": {
              "table": "people",
              "schema": "people_schema",
              "row_count": "people_rows",
              "sheets": "book_sheets"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }

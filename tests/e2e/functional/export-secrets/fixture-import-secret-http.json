{
  "name": "zz-import-secret-http",
  "version": "1.0.0",
  "description": "A secret variable read by an HTTP header, sent to the http-echo retry counter under the run key, then probed with the same key.",
  "workflow": {
    "nodes": [
      {
        "id": "try-send",
        "type": "workflowNode",
        "position": { "x": 300, "y": 120 },
        "data": {
          "label": "Try the secret request",
          "elementType": "try-catch-finally",
          "nodeType": "control",
          "category": "flow",
          "version": "1.0.0",
          "description": "Try the secret request",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": { "enable_catch": true, "enable_finally": false },
            "outputBindings": { "error": "e_http" },
            "profileBindings": []
          }
        },
        "measured": { "width": 200, "height": 62 }
      },
      {
        "id": "http-secret",
        "type": "workflowNode",
        "position": { "x": 600, "y": 200 },
        "data": {
          "label": "Send with the imported secret",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Send with the imported secret",
          "hasNewerVersion": false,
          "expressionFields": ["auth_password"],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": {
              "method": "GET",
              "url": "https://127.0.0.1:9449/retry?key=__RUN_KEY__&fail_count=1&fail_status=502",
              "auth_enabled": true,
              "auth_mode": "basic",
              "auth_username": "wave",
              "auth_password": "api_tok",
              "timeout": 10,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": ["502", "503", "504"],
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "catch-log",
        "type": "workflowNode",
        "position": { "x": 900, "y": 200 },
        "data": {
          "label": "Caught the refused request",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Caught the refused request",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": { "message": "'caught: ' + e_http['message']", "level": "WARN" },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "probe",
        "type": "workflowNode",
        "position": { "x": 300, "y": 320 },
        "data": {
          "label": "Probe the run key",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Probe the run key",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": {
              "method": "GET",
              "url": "https://127.0.0.1:9449/retry?key=__RUN_KEY__&fail_count=1&fail_status=502",
              "timeout": 10,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": ["502", "503", "504"],
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": { "status_code": "probe_status", "body": "probe_body" },
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "bookend",
        "type": "workflowNode",
        "position": { "x": 300, "y": 420 },
        "data": {
          "label": "Bookend",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend",
          "hasNewerVersion": false,
          "expressionFields": ["message"],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": { "message": "'import-secret-done-__RUN_KEY__'", "level": "INFO" },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      }
    ],
    "edges": [
      { "id": "e-start-try", "source": "start-node", "target": "try-send", "type": "default" },
      { "id": "e-try-http", "source": "try-send", "target": "http-secret", "type": "default", "sourceHandle": "try" },
      { "id": "e-catch-log", "source": "try-send", "target": "catch-log", "type": "default", "sourceHandle": "catch" },
      { "id": "e-then-probe", "source": "try-send", "target": "probe", "type": "default", "sourceHandle": "then" },
      { "id": "e-probe-bookend", "source": "probe", "target": "bookend", "type": "default" }
    ]
  },
  "variables": {
    "api_tok": { "type": "string", "value": "__SECRET_VALUE__", "scope": "test", "secret": true },
    "e_http": { "type": "map", "value": null, "scope": "test" },
    "probe_status": { "type": "integer", "value": 0, "scope": "test" },
    "probe_body": { "type": "string", "value": "", "scope": "test" }
  },
  "metadata": {}
}

              "content": "<!doctype html><html><head><meta charset=\"utf-8\"><title>Page from a system under test</title></head><body><p id=\"verdict\">pending</p><script>fetch('/artifacts?per_page=1').then(function (r) { return r.json() }).then(function () { document.getElementById('verdict').textContent = 'read' }, function () { document.getElementById('verdict').textContent = 'blocked' })</script></body></html>",

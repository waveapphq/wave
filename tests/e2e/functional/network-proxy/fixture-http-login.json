{
  "name": "V-NET-PROXY HTTP Login Proxy",
  "version": "1.0.0",
  "description": "Two HTTP blocks on WAVE setting against the proxy-only http-target, plain HTTP and HTTPS, each in a Try/Catch that binds the caught error.",
  "workflow": {
    "nodes": [
      {
        "id": "tc-plain",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 100
        },
        "data": {
          "label": "Try/Catch",
          "elementType": "try-catch-finally",
          "nodeType": "control",
          "category": "flow",
          "version": "1.0.0",
          "description": "Plain guard",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": {
              "enable_catch": true,
              "enable_finally": false
            },
            "outputBindings": {
              "error": "plain_err"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 200,
          "height": 62
        }
      },
      {
        "id": "http-plain",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 170
        },
        "data": {
          "label": "Login plain",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Login plain",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "url": "http://http-target:9444/api",
              "method": "GET",
              "timeout": 15,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": [
                "502",
                "503",
                "504"
              ],
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10,
              "proxy_mode": "wave-setting"
            },
            "outputBindings": {
              "status_code": "plain_status",
              "body": "plain_body"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {

{
  "name": "V-NET-PROXY Shell Environment",
  "version": "1.0.0",
  "description": "An HTTP block on WAVE setting against the proxy-only http-target, then a Shell Exec that prints its environment.",
  "workflow": {
    "nodes": [
      {
        "id": "http-check",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 100
        },
        "data": {
          "label": "Proxy in force",
          "elementType": "http-client",
          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Proxy in force",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "url": "http://http-target:9444/api",
              "method": "GET",
              "timeout": 15,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": [
                "502",
                "503",
                "504"
              ],
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10,
              "proxy_mode": "wave-setting"
            },
            "outputBindings": {
              "status_code": "check_status"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "shell-env",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 170
        },
        "data": {
          "label": "Shell Exec",
          "elementType": "shell-exec",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Environment",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "config": {
            "values": {
              "command": "env"
            },
            "outputBindings": {
              "stdout": "env_out"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-done",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 240
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'proxy-env-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "edge-start-http-check",
        "source": "start-node",
        "target": "http-check",
        "type": "default"
      },
      {
        "id": "edge-http-check-shell-env",
        "source": "http-check",
        "target": "shell-env",
        "type": "default"
      },
      {
        "id": "edge-shell-env-log-done",
        "source": "shell-env",
        "target": "log-done",
        "type": "default"
      }
    ]
  },
  "variables": {
    "check_status": {
      "value": 0,
      "type": "integer",
      "scope": "test"
    },
    "env_out": {
      "value": "",
      "type": "string",
      "scope": "test"
    }
  },
  "metadata": {
    "tags": [],
    "suite_id": null,
    "parent_suite": null
  }
}

{
  "name": "Variable Edits Secrets E2E",
  "version": "1.0.0",
  "description": "Two requests to the http-echo secret-payload endpoint, each binding its body to a plain variable with no value, and a Log block per variable. One request marks its body output secret; the other is marked by the spec after it ran.",
  "workflow": {
    "nodes": [
      {
        "id": "http-marked",
        "type": "workflowNode",
        "position": { "x": 240, "y": 140 },
        "data": {

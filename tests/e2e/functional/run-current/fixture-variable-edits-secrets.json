          "nodeType": "plugin",
          "category": "network",
          "version": "1.0.0",
          "description": "Marked Request",
          "hasNewerVersion": false,
          "expressionFields": ["url"],
          "templateFields": [],
          "config": {
            "values": {
              "url": "f'https://127.0.0.1:9449/secret-payload'",
              "method": "GET",
              "timeout": 30,
              "retry_count": 0,
              "retry_delay": 1,
              "retry_backoff_factor": 2,
              "retryable_status_codes": ["502", "503", "504"],
              "verify_ssl": false,
              "allow_redirects": true,
              "max_redirects": 10
            },
            "outputBindings": { "body": "marked_body" },
            "outputSecretFields": ["body"],
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },

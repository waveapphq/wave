              ],
              "timeout": 30000,
              "check_interval": 300,
              "message": "wu-p1 never landed",
              "mode": "retry",
              "fail_current_scope": false
            },
            "outputBindings": { "passed": "p1_passed", "elapsed": "p1_elapsed" },
            "profileBindings": []
          }
        },
        "measured": { "width": 160, "height": 62 }

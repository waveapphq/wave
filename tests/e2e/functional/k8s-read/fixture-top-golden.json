{
  "name": "K8s Top Golden",
  "version": "1.0.0",
  "description": "",
  "workflow": {
    "nodes": [
      {
        "id": "connect-golden",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 100
        },
        "data": {
          "label": "K8s Connect",
          "elementType": "k8s-connect",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Admin session, default namespace written by the spec",
          "hasNewerVersion": false,
          "expressionFields": [
            "token",
            "ca_cert"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "api_url": "https://127.0.0.1:9460",
              "namespace": "",
              "timeout": 30,
              "token": "k8s_admin_token",
              "verify_ssl": true,
              "ca_cert": "k8s_ca"
            },
            "outputBindings": {
              "session": "sess_golden"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "top-golden",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 170
        },
        "data": {
          "label": "K8s Top",
          "elementType": "k8s-top",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "[T-04|T-06] pod scope, one pod by name",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "sess_golden",
              "timeout": 30,
              "scope": "pod",
              "select_by": "name",
              "name": "wave-pod-labeled"
            },
            "outputBindings": {
              "usage": "golden_usage",
              "count": "golden_count"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-golden",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 240
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Marker for the golden leg",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f'[T-04|T-06] rows={golden_count}'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-golden-done",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 310
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'k8s-top-golden-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "edge-start-connect-golden",
        "source": "start-node",
        "target": "connect-golden"
      },
      {
        "id": "edge-connect-golden-top-golden",
        "source": "connect-golden",
        "target": "top-golden"
      },
      {
        "id": "edge-top-golden-log-golden",
        "source": "top-golden",
        "target": "log-golden"
      },
      {
        "id": "edge-log-golden-log-golden-done",
        "source": "log-golden",
        "target": "log-golden-done"
      }
    ]
  },
  "variables": {
    "k8s_admin_token": {
      "value": "",
      "type": "string",
      "scope": "test",
      "secret": true
    },
    "k8s_ca": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "sess_golden": {
      "value": "",
      "type": "string",
      "scope": "test"
    },
    "golden_usage": {
      "value": [],
      "type": "table",
      "scope": "test"
    },
    "golden_count": {
      "value": 0,
      "type": "integer",
      "scope": "test"
    }
  },
  "metadata": {
    "tags": [],
    "suite_id": null,
    "parent_suite": null
  }
}

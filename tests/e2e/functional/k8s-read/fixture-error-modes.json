{
  "name": "K8s Read Error Modes E2E Test",
  "version": "1.0.0",
  "description": "",
  "workflow": {
    "nodes": [
      {
        "id": "connect-admin",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 100
        },
        "data": {
          "label": "K8s Connect",
          "elementType": "k8s-connect",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Admin session, default namespace = the run namespace",
          "hasNewerVersion": false,
          "expressionFields": [
            "token",
            "ca_cert",
            "namespace"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "api_url": "https://127.0.0.1:9460",
              "namespace": "run_namespace",
              "timeout": 30,
              "token": "k8s_admin_token",
              "verify_ssl": true,
              "ca_cert": "k8s_ca",
              "acquire_run_token": false
            },
            "outputBindings": {
              "session": "k8s_session"
            },
            "profileBindings": [],
            "outputSecretFields": [
              "session"
            ]
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "tc-S-19",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 170
        },
        "data": {
          "label": "Try/Catch",
          "elementType": "try-catch-finally",
          "nodeType": "control",
          "category": "flow",
          "version": "1.0.0",
          "description": "S-19 guard",
          "hasNewerVersion": false,
          "expressionFields": [],
          "templateFields": [],
          "variableExpressionKeys": [],
          "config": {
            "values": {
              "enable_catch": true,
              "enable_finally": false
            },
            "outputBindings": {
              "error": "leg_err"
            },
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "blk-S-19",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 240
        },
        "data": {
          "label": "K8s Get",
          "elementType": "k8s-get",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "S-19 read a missing Pod with On error = Fail the block",
          "hasNewerVersion": false,
          "expressionFields": [
            "session"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "session": "k8s_session",
              "resource_type": "default",
              "kind": "Pod",
              "search_by": "name",
              "name": "wave-e2e-missing-pod",
              "output_format": "map",
              "on_error": "fail",
              "timeout": 30
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-S-19-caught",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 310
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "S-19 catch marker",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'r7-S-19 caught'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-S-19-msg",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 380
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "S-19 caught message, read on the then branch",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "f\"r7-S-19 msg={leg_err['message'] if leg_err else 'NO-ERROR-CAUGHT'}\"",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      },
      {
        "id": "log-done",
        "type": "workflowNode",
        "position": {
          "x": -75,
          "y": 450
        },
        "data": {
          "label": "Log",
          "elementType": "log",
          "nodeType": "plugin",
          "category": "system",
          "version": "1.0.0",
          "description": "Bookend marker",
          "hasNewerVersion": false,
          "expressionFields": [
            "message"
          ],
          "templateFields": [],
          "config": {
            "values": {
              "message": "'r7-golden-done'",
              "level": "INFO"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": {
          "width": 120,
          "height": 62
        }
      }
    ],
    "edges": [
      {
        "id": "edge-start-connect-admin",
        "source": "start-node",
        "target": "connect-admin"
      },
      {
        "id": "edge-connect-admin-tc-S-19",
        "source": "connect-admin",
        "target": "tc-S-19"
      },
      {
        "id": "edge-tc-S-19-try",

        "target": "log-S-19-caught",
        "sourceHandle": "catch"
      },
      {
        "id": "edge-tc-S-19-then",
        "source": "tc-S-19",
        "target": "log-S-19-msg",
        "sourceHandle": "then"
      },
      {
        "id": "edge-log-S-19-msg-log-done",
        "source": "log-S-19-msg",
        "target": "log-done"
      }
    ]
  },

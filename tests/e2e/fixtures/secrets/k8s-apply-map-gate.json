{
  "name": "K8s Apply Map Credential Gate E2E",
  "version": "1.0.0",
  "description": "A K8s Apply Secret Data map is a declared MAP credential: it seals value by value, so a stored map renders as one protected value while the ConfigMap Data map on the same test keeps its keys and values.",
  "workflow": {
    "nodes": [
      {
        "id": "apply-secret",
        "type": "workflowNode",
        "position": { "x": 0, "y": 100 },
        "data": {
          "label": "K8s Apply",
          "elementType": "k8s-apply",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "Secret data gate",
          "hasNewerVersion": false,
          "expressionFields": ["session"],
          "templateFields": [],
          "config": {
            "values": {
              "session": "k8s_session",
              "timeout": 30,
              "define_with": "form",
              "kind": "Secret",
              "name": "gate-secret",
              "secret_type": "kubernetes.io/tls",
              "secret_data": {
                "tls.crt": "stored-crt-7c1d9",
                "tls.key": "stored-key-4b2e8"
              },
              "if_exists": "update",
              "output_format": "map"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      },
      {
        "id": "apply-config",
        "type": "workflowNode",
        "position": { "x": 0, "y": 220 },
        "data": {
          "label": "K8s Apply",
          "elementType": "k8s-apply",
          "nodeType": "plugin",
          "category": "kubernetes",
          "version": "1.0.0",
          "description": "ConfigMap data control",
          "hasNewerVersion": false,
          "expressionFields": ["session"],
          "templateFields": [],
          "config": {
            "values": {
              "session": "k8s_session",
              "timeout": 30,
              "define_with": "form",
              "kind": "ConfigMap",
              "name": "gate-config",
              "data": {
                "log_level": "debug",
                "replica_hint": "2"
              },
              "if_exists": "update",
              "output_format": "map"
            },
            "outputBindings": {},
            "profileBindings": []
          }
        },
        "measured": { "width": 120, "height": 62 }
      }
    ],
    "edges": [
      { "id": "e-start", "source": "start-node", "target": "apply-secret" },
      { "id": "e-secret-config", "source": "apply-secret", "target": "apply-config" }
    ]
  },
  "variables": {
    "k8s_session": { "value": "", "type": "string", "scope": "test" }
  },
  "metadata": { "tags": [], "suite_id": null, "parent_suite": null }
}

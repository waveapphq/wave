# WAVE E2E CI Container Image
# Extends wave-ci:latest with Playwright browser + system deps so each shard
# can run uvicorn, vite preview, the HTTPS simulator, and the Playwright test
# runner inside a single CPU/memory-isolated container, plus the pinned helm
# binary the Helm blocks shell out to.
#
# Build: ./scripts/build-e2e-image.sh

FROM wave-ci:latest

# Playwright chromium system deps (libs + fonts) need root.
USER root

ENV DEBIAN_FRONTEND=noninteractive

# The exact package list comes from `npx playwright install-deps chromium
# --dry-run` on Ubuntu 22.04 (jammy). We install explicitly rather than run
# `playwright install --with-deps` so the image build is deterministic and
# does not need a second round of apt once we drop back to ciuser.
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-unifont \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libegl1 \
        libfontconfig1 \
        libgbm1 \
        libgdk-pixbuf-2.0-0 \
        libgl1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxshmfence1 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxi6 \
        libxtst6 \
        procps \
        xauth \
        xvfb \
        > /dev/null && \
    rm -rf /var/lib/apt/lists/*

# Helm for the Helm block functional specs. Pinned version + checksum, like the
# tools baked into tests/e2e/services/kwok/Containerfile.
ARG HELM_VERSION=4.2.4
ARG HELM_SHA256_AMD64=c306b46f719b0a4da32d0f78ee21bf90ce8d602f15b22ab753f0674d1670a7f3
ARG HELM_SHA256_ARM64=564de2191b881e9f71b5606b25345821ea1682f06ab90499d3ab22b530176da1
RUN arch="$(dpkg --print-architecture)" && \
    case "${arch}" in \
        amd64) sha="${HELM_SHA256_AMD64}" ;; \
        arm64) sha="${HELM_SHA256_ARM64}" ;; \
        *) echo "unsupported architecture for helm: ${arch}" >&2; exit 1 ;; \
    esac && \
    curl -fsSLo /tmp/helm.tar.gz "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${arch}.tar.gz" && \
    echo "${sha}  /tmp/helm.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/helm.tar.gz -C /tmp "linux-${arch}/helm" && \
    install -m 0755 "/tmp/linux-${arch}/helm" /usr/local/bin/helm && \
    rm -rf /tmp/helm.tar.gz "/tmp/linux-${arch}" && \
    helm version --short

USER ciuser
WORKDIR /workspace

# Ensure Playwright's browser cache lives at a predictable path that is
# isolated from the host (the runtime mount replaces /workspace but leaves
# /home/ciuser alone, so browsers baked here survive).
ENV PLAYWRIGHT_BROWSERS_PATH=/home/ciuser/.cache/ms-playwright

# Install chromium only (not webkit/firefox - WAVE's Playwright suite is
# chromium-only). Pin to the playwright version used by tests/e2e so the
# downloaded browser revision matches what the test runner expects.
RUN npx --yes playwright@1.57.0 install chromium && \
    du -sh /home/ciuser/.cache/ms-playwright

CMD ["/bin/bash"]
